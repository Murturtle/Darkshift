package com.reo.darkshift

import android.Manifest
import android.content.Context
import android.content.pm.PackageManager
import android.provider.Settings

/**
 * Switches Android's own display settings while Darkshift is on: the system dark theme, "force
 * dark" so apps without a dark theme get one, and Android's monochrome color correction. The
 * previous values are saved and put back on [restore].
 *
 * Writing these secure settings needs WRITE_SECURE_SETTINGS, which only adb can grant
 * (`adb shell pm grant com.reo.darkshift android.permission.WRITE_SECURE_SETTINGS`).
 */
class SystemTheme(private val context: Context) {
    private val resolver = context.contentResolver
    private val saved = context.getSharedPreferences(SAVED_PREFS_NAME, Context.MODE_PRIVATE)

    val canWrite: Boolean
        get() = context.checkSelfPermission(Manifest.permission.WRITE_SECURE_SETTINGS) ==
            PackageManager.PERMISSION_GRANTED

    fun apply() {
        if (!canWrite) return
        for ((key, value) in DARK_SETTINGS) {
            // Only remember the user's own value, never one we wrote ourselves.
            if (!saved.contains(key)) {
                saved.edit().putInt(key, Settings.Secure.getInt(resolver, key, UNSET)).commit()
            }
            Settings.Secure.putInt(resolver, key, value)
        }
    }

    fun restore() {
        if (!canWrite) return
        for (key in DARK_SETTINGS.keys) {
            if (!saved.contains(key)) continue
            val previous = saved.getInt(key, UNSET)
            if (previous == UNSET) {
                Settings.Secure.putString(resolver, key, null)
            } else {
                Settings.Secure.putInt(resolver, key, previous)
            }
            saved.edit().remove(key).commit()
        }
    }

    private companion object {
        const val SAVED_PREFS_NAME = "darkshift_system_theme"
        const val UNSET = Int.MIN_VALUE

        const val UI_NIGHT_MODE = "ui_night_mode"
        const val FORCE_DARK = "accessibility_force_invert_color_enabled"
        const val NIGHT_MODE_YES = 2

        // Color correction runs after everything is composited, overlay included.
        const val DALTONIZER_ENABLED = "accessibility_display_daltonizer_enabled"
        const val DALTONIZER_TYPE = "accessibility_display_daltonizer"
        const val DALTONIZER_MONOCHROMACY = 0

        val DARK_SETTINGS = mapOf(
            UI_NIGHT_MODE to NIGHT_MODE_YES,
            FORCE_DARK to 1,
            DALTONIZER_TYPE to DALTONIZER_MONOCHROMACY,
            DALTONIZER_ENABLED to 1,
        )
    }
}
