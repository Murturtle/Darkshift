package com.reo.darkshift

import android.content.Intent
import android.os.Bundle
import android.provider.Settings
import android.view.View
import android.widget.Button
import androidx.appcompat.app.AppCompatActivity
import android.widget.TextView
import com.google.android.material.button.MaterialButtonToggleGroup
import com.google.android.material.slider.Slider
import com.google.android.material.switchmaterial.SwitchMaterial
import kotlin.math.roundToInt

class MainActivity : AppCompatActivity() {
    private lateinit var settings: DarkshiftSettings

    private lateinit var serviceCard: View
    private lateinit var permissionCard: View
    private lateinit var enableSwitch: SwitchMaterial
    private lateinit var colorGroup: MaterialButtonToggleGroup
    private lateinit var intensitySlider: Slider
    private lateinit var intensityLabel: TextView

    // Raised while render() updates the controls, so those updates are not written back as user changes.
    private var rendering = false

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)
        settings = DarkshiftSettings(this)

        serviceCard = findViewById(R.id.service_card)
        permissionCard = findViewById(R.id.permission_card)
        enableSwitch = findViewById(R.id.enable_switch)
        colorGroup = findViewById(R.id.color_group)
        intensitySlider = findViewById(R.id.intensity_slider)
        intensityLabel = findViewById(R.id.intensity_label)

        findViewById<Button>(R.id.open_accessibility_settings).setOnClickListener {
            startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
        }

        enableSwitch.setOnCheckedChangeListener { _, checked ->
            if (!rendering) settings.update { it.copy(enabled = checked) }
        }
        colorGroup.addOnButtonCheckedListener { _, id, checked ->
            if (!checked || rendering) return@addOnButtonCheckedListener
            settings.update { it.copy(red = id == R.id.choice_red) }
        }
        intensitySlider.addOnChangeListener { _, value, fromUser ->
            intensityLabel.text = percent(value)
            if (fromUser) settings.update { it.copy(intensity = value) }
        }
    }

    override fun onResume() {
        super.onResume()
        render()
    }

    private fun render() {
        rendering = true
        val config = settings.config
        serviceCard.visibility = if (DarkshiftService.isRunning) View.GONE else View.VISIBLE
        permissionCard.visibility = if (SystemTheme(this).canWrite) View.GONE else View.VISIBLE
        enableSwitch.isChecked = config.enabled
        colorGroup.check(if (config.red) R.id.choice_red else R.id.choice_green)
        intensitySlider.value = config.intensity.coerceIn(OverlayColor.MIN_INTENSITY, OverlayColor.MAX_INTENSITY)
        intensityLabel.text = percent(intensitySlider.value)
        rendering = false
    }

    private fun percent(value: Float) = "${(value * 100).roundToInt()}%"
}
