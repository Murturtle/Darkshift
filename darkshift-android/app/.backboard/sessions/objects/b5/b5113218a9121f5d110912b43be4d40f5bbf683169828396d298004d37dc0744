package com.reo.darkshift

import kotlin.math.roundToInt

/**
 * Turns the slider values into the one translucent color the overlay is filled with.
 *
 * An overlay can only alpha-blend over the screen (out = screen * (1 - a) + color * a), so unlike
 * the GNOME shader it cannot treat pixels individually. What it can do exactly:
 *  - scale every pixel's brightness (Max value and Darkness), by blending in black;
 *  - tint the picture towards green or red (Green <-> Red), by blending in a little of that color.
 *    That tint also lifts true black slightly, so it is kept weak.
 */
object OverlayColor {
    /** Max value scales the brightest channel from this share up to 1. */
    const val MIN_MAX_VALUE = 0.33f

    /** Darkness at 1 dims the screen by this share, on top of Max value. */
    const val MAX_DARKNESS_DIM = 0.4f

    const val TINT_ALPHA = 0.08f
    const val MONOTONE_TINT_ALPHA = 0.16f

    /** Share of the original brightness that stays visible. */
    fun brightness(config: DarkshiftConfig): Float =
        mix(MIN_MAX_VALUE, 1f, config.maxValue.coerceIn(0f, 1f)) *
            (1f - config.darkness.coerceIn(0f, 1f) * MAX_DARKNESS_DIM)

    /** Straight (non-premultiplied) ARGB for the overlay view's background. */
    fun argb(config: DarkshiftConfig): Int {
        val shift = config.colorShift.coerceIn(0f, 1f).let {
            if (config.monotone) (if (it >= 0.5f) 1f else 0f) else it
        }
        val tintAlpha = if (config.monotone) MONOTONE_TINT_ALPHA else TINT_ALPHA
        val dim = 1f - brightness(config)

        // Tint first, then dim: out = screen * (1 - tint) * (1 - dim) + tintColor * tint * (1 - dim).
        val alpha = 1f - (1f - tintAlpha) * (1f - dim)
        if (alpha <= 0f) return 0
        val red = (shift * 2f).coerceAtMost(1f)
        val green = ((1f - shift) * 2f).coerceAtMost(1f)
        val scale = tintAlpha * (1f - dim) / alpha

        return (alpha.toByte255() shl 24) or
            ((red * scale).toByte255() shl 16) or
            ((green * scale).toByte255() shl 8)
    }

    private fun mix(a: Float, b: Float, t: Float) = a + (b - a) * t

    private fun Float.toByte255() = (this * 255f).roundToInt().coerceIn(0, 255)
}
