package com.reo.darkshift

import android.content.Intent
import android.os.Bundle
import android.provider.Settings
import android.view.View
import android.widget.Button
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity
import com.google.android.material.button.MaterialButtonToggleGroup
import com.google.android.material.materialswitch.MaterialSwitch
import com.google.android.material.slider.Slider
import kotlin.math.roundToInt

class MainActivity : AppCompatActivity() {
    private lateinit var settings: DarkshiftSettings

    private lateinit var serviceCard: View
    private lateinit var enableSwitch: MaterialSwitch
    private lateinit var modeGroup: MaterialButtonToggleGroup
    private lateinit var darknessSlider: Slider
    private lateinit var colorShiftRow: View
    private lateinit var colorShiftSlider: Slider
    private lateinit var colorChoiceGroup: MaterialButtonToggleGroup
    private lateinit var maxValueSlider: Slider
    private lateinit var maxValueLabel: TextView

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)
        settings = DarkshiftSettings(this)

        serviceCard = findViewById(R.id.service_card)
        enableSwitch = findViewById(R.id.enable_switch)
        modeGroup = findViewById(R.id.mode_group)
        darknessSlider = findViewById(R.id.darkness_slider)
        colorShiftRow = findViewById(R.id.color_shift_row)
        colorShiftSlider = findViewById(R.id.color_shift_slider)
        colorChoiceGroup = findViewById(R.id.color_choice_group)
        maxValueSlider = findViewById(R.id.max_value_slider)
        maxValueLabel = findViewById(R.id.max_value_label)

        findViewById<Button>(R.id.open_accessibility_settings).setOnClickListener {
            startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
        }

        enableSwitch.setOnCheckedChangeListener { button, checked ->
            if (button.isPressed) settings.update { it.copy(enabled = checked) }
        }
        modeGroup.addOnButtonCheckedListener { _, id, checked ->
            if (!checked) return@addOnButtonCheckedListener
            settings.update { it.copy(monotone = id == R.id.mode_monotone) }
            render()
        }
        colorChoiceGroup.addOnButtonCheckedListener { _, id, checked ->
            if (!checked) return@addOnButtonCheckedListener
            settings.update { it.copy(colorShift = if (id == R.id.choice_red) 1f else 0f) }
        }
        darknessSlider.addOnChangeListener { _, value, fromUser ->
            if (fromUser) settings.update { it.copy(darkness = value) }
        }
        colorShiftSlider.addOnChangeListener { _, value, fromUser ->
            if (fromUser) settings.update { it.copy(colorShift = value) }
        }
        maxValueSlider.addOnChangeListener { _, value, fromUser ->
            maxValueLabel.text = maxValuePercent(value)
            if (fromUser) settings.update { it.copy(maxValue = value) }
        }
        findViewById<Button>(R.id.reset_button).setOnClickListener {
            settings.reset()
            render()
        }
    }

    override fun onResume() {
        super.onResume()
        render()
    }

    /** Shows what is saved; the listeners above only write back changes made by the user. */
    private fun render() {
        val config = settings.config
        serviceCard.visibility = if (DarkshiftService.isRunning) View.GONE else View.VISIBLE
        enableSwitch.isChecked = config.enabled
        modeGroup.check(if (config.monotone) R.id.mode_monotone else R.id.mode_multicolor)
        darknessSlider.value = config.darkness.coerceIn(0f, 1f)
        colorShiftSlider.value = config.colorShift.coerceIn(0f, 1f)
        maxValueSlider.value = config.maxValue.coerceIn(0f, 1f)
        maxValueLabel.text = maxValuePercent(config.maxValue)

        // Monotone mode has no in-between: just pick green or red.
        colorShiftRow.visibility = if (config.monotone) View.GONE else View.VISIBLE
        colorChoiceGroup.visibility = if (config.monotone) View.VISIBLE else View.GONE
        colorChoiceGroup.check(if (config.colorShift >= 0.5f) R.id.choice_red else R.id.choice_green)
    }

    private fun maxValuePercent(value: Float): String {
        val brightness = OverlayColor.MIN_MAX_VALUE + (1f - OverlayColor.MIN_MAX_VALUE) * value
        return "${(brightness * 100).roundToInt()}%"
    }
}
