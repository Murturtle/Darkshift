package com.reo.darkshift

import android.content.Context
import android.content.SharedPreferences

/** Slider values are all 0..1, same as the GNOME extension. */
data class DarkshiftConfig(
    val enabled: Boolean = DEFAULT_ENABLED,
    val monotone: Boolean = DEFAULT_MONOTONE,
    val darkness: Float = DEFAULT_DARKNESS,
    /** 0 = green, 1 = red. */
    val colorShift: Float = DEFAULT_COLOR_SHIFT,
    val maxValue: Float = DEFAULT_MAX_VALUE,
) {
    companion object {
        const val DEFAULT_ENABLED = false
        const val DEFAULT_MONOTONE = false
        const val DEFAULT_DARKNESS = 0.75f
        const val DEFAULT_COLOR_SHIFT = 1f / 3f
        const val DEFAULT_MAX_VALUE = 1f
    }
}

class DarkshiftSettings(context: Context) {
    private val prefs: SharedPreferences =
        context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)

    var config: DarkshiftConfig
        get() = DarkshiftConfig(
            enabled = prefs.getBoolean(KEY_ENABLED, DarkshiftConfig.DEFAULT_ENABLED),
            monotone = prefs.getBoolean(KEY_MONOTONE, DarkshiftConfig.DEFAULT_MONOTONE),
            darkness = prefs.getFloat(KEY_DARKNESS, DarkshiftConfig.DEFAULT_DARKNESS),
            colorShift = prefs.getFloat(KEY_COLOR_SHIFT, DarkshiftConfig.DEFAULT_COLOR_SHIFT),
            maxValue = prefs.getFloat(KEY_MAX_VALUE, DarkshiftConfig.DEFAULT_MAX_VALUE),
        )
        set(value) = prefs.edit()
            .putBoolean(KEY_ENABLED, value.enabled)
            .putBoolean(KEY_MONOTONE, value.monotone)
            .putFloat(KEY_DARKNESS, value.darkness)
            .putFloat(KEY_COLOR_SHIFT, value.colorShift)
            .putFloat(KEY_MAX_VALUE, value.maxValue)
            .apply()

    fun update(change: (DarkshiftConfig) -> DarkshiftConfig) {
        config = change(config)
    }

    /** Back to the default slider values; the on/off state is left alone. */
    fun reset() = update { DarkshiftConfig(enabled = it.enabled) }

    fun registerListener(listener: SharedPreferences.OnSharedPreferenceChangeListener) =
        prefs.registerOnSharedPreferenceChangeListener(listener)

    fun unregisterListener(listener: SharedPreferences.OnSharedPreferenceChangeListener) =
        prefs.unregisterOnSharedPreferenceChangeListener(listener)

    private companion object {
        const val PREFS_NAME = "darkshift"
        const val KEY_ENABLED = "enabled"
        const val KEY_MONOTONE = "monotone"
        const val KEY_DARKNESS = "darkness"
        const val KEY_COLOR_SHIFT = "colorShift"
        const val KEY_MAX_VALUE = "maxValue"
    }
}
