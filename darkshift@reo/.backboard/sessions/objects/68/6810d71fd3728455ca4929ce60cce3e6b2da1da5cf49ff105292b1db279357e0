import Clutter from 'gi://Clutter';
import GObject from 'gi://GObject';

import * as Main from 'resource:///org/gnome/shell/ui/main.js';

import {Extension, gettext as _} from 'resource:///org/gnome/shell/extensions/extension.js';
import {QuickToggle, SystemIndicator} from 'resource:///org/gnome/shell/ui/quickSettings.js';

// How hard blacks get crushed towards true black (0 = untouched, 1 = max).
const BLACK_BOOST = 0.55;
// How much of the blue channel's energy gets moved onto red/green instead
// of being displayed, so fewer blue sub-pixels have to light up.
const BLUE_SHIFT = 0.35;

const DarkshiftEffect = GObject.registerClass(
class DarkshiftEffect extends Clutter.ShaderEffect {
    vfunc_get_static_shader_source() {
        return `
            uniform sampler2D tex;
            uniform float black_boost;
            uniform float blue_shift;

            void main() {
                vec4 color = texture2D(tex, cogl_tex_coord_in[0].st);

                /* Crush blacks: a gentle power curve pushes dark tones
                 * closer to true black without blowing out highlights. */
                color.rgb = pow(color.rgb, vec3(1.0 + black_boost));

                /* Shift light away from the blue sub-pixel: take some of
                 * the blue channel's energy and redistribute it onto red
                 * and green, which is where OLEDs are more efficient. */
                float removed = color.b * blue_shift;
                color.b -= removed;
                color.r += removed * 0.6;
                color.g += removed * 0.4;

                cogl_color_out = color * cogl_color_in;
            }
        `;
    }

    vfunc_paint_target(node, paintContext) {
        this.set_uniform_value('tex', 0);
        this.set_uniform_value('black_boost', BLACK_BOOST);
        this.set_uniform_value('blue_shift', BLUE_SHIFT);
        super.vfunc_paint_target(node, paintContext);
    }
});

const DarkshiftToggle = GObject.registerClass(
class DarkshiftToggle extends QuickToggle {
    constructor() {
        super({
            title: _('Darkshift'),
            iconName: 'preferences-desktop-display-symbolic',
            toggleMode: true,
        });
    }
});

const DarkshiftIndicator = GObject.registerClass(
class DarkshiftIndicator extends SystemIndicator {
    constructor() {
        super();

        this._indicator = this._addIndicator();
        this._indicator.iconName = 'preferences-desktop-display-symbolic';

        this._toggle = new DarkshiftToggle();
        this._toggle.bind_property('checked',
            this._indicator, 'visible',
            GObject.BindingFlags.SYNC_CREATE);
        this._toggle.connect('notify::checked', toggle => {
            if (toggle.checked)
                this._enableEffect();
            else
                this._disableEffect();
        });
        this.quickSettingsItems.push(this._toggle);
    }

    _enableEffect() {
        if (this._effect)
            return;

        this._effect = new DarkshiftEffect();
        global.window_group.add_effect(this._effect);
    }

    _disableEffect() {
        if (!this._effect)
            return;

        global.window_group.remove_effect(this._effect);
        this._effect = null;
    }

    destroy() {
        this._disableEffect();
        super.destroy();
    }
});

export default class DarkshiftExtension extends Extension {
    enable() {
        this._indicator = new DarkshiftIndicator();
        Main.panel.statusArea.quickSettings.addExternalIndicator(this._indicator);
    }

    disable() {
        this._indicator.quickSettingsItems.forEach(item => item.destroy());
        this._indicator.destroy();
        this._indicator = null;
    }
}
