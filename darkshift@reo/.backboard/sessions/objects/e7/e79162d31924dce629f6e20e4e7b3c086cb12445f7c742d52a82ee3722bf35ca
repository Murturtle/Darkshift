import Clutter from 'gi://Clutter';
import GObject from 'gi://GObject';
import Meta from 'gi://Meta';
import Shell from 'gi://Shell';
import St from 'gi://St';

import * as Main from 'resource:///org/gnome/shell/ui/main.js';

import {Extension, gettext as _} from 'resource:///org/gnome/shell/extensions/extension.js';
import * as PopupMenu from 'resource:///org/gnome/shell/ui/popupMenu.js';
import {QuickMenuToggle, SystemIndicator} from 'resource:///org/gnome/shell/ui/quickSettings.js';
import {Slider} from 'resource:///org/gnome/shell/ui/slider.js';

// blackBoost: how hard blacks get crushed towards true black (0 = untouched).
// blueShift: share of the blue channel moved onto red/green instead of being
//            displayed, so fewer blue sub-pixels have to light up.
// redShift:  share of the red channel moved onto green instead.
// grayDarken: extra multiplier on near-neutral (gray) colors, on top of the
//            black crush (1.0 = untouched, lower = darker).
// protectGreen: how much of the green channel's brightness is kept out of the
//            black crush and gray darkening (1 = fully kept, 0 = dimmed like
//            red and blue).
// neutralProtect: 1 skips the red/blue shift on neutral pixels so white pages
//            stay gray instead of turning green.
// neutralGreenGain: above 0, neutral pixels are drawn with green only, at this
//            peak brightness (0 = off).
// normalizeGreen: how strongly green pixels are pulled into one brightness
//            band (dark greens lifted, bright greens capped) instead of
//            keeping their original, uneven brightness.
const NORMAL_SETTINGS = {blackBoost: 0.2, blueShift: 0.3, redShift: 0.4, grayDarken: 0.5, protectGreen: 1.0, normalizeGreen: 0, neutralProtect: 0, neutralGreenGain: 0};
const EXTREME_SETTINGS = {blackBoost: 1.2, blueShift: 1.0, redShift: 1.0, grayDarken: 0.35, protectGreen: 1.0, normalizeGreen: 1, neutralProtect: 0, neutralGreenGain: 0.6};

// The wallpaper is only dimmed (no color shift); negative brightness darkens.
const NORMAL_WALLPAPER_BRIGHTNESS = -0.85;
const EXTREME_WALLPAPER_BRIGHTNESS = -0.85;

const WALLPAPER_EFFECT_NAME = 'darkshift-wallpaper';

// The window outline is drawn in pure red, which the shader recognizes and
// swaps for this dim white-gray (0.35 * 255 = 89). Windows that skip the
// shader (video, graphics, games) use the same gray directly.
const OUTLINE_KEY_STYLE = 'border: 1px solid red;';
const OUTLINE_PLAIN_STYLE = 'border: 1px solid rgb(89, 89, 89);';

// The darkness slider runs 0..1 and only moves the black threshold: 0 leaves
// tones as they are, and higher values send more of the darkest tones and
// grays to pure black (up to MAX_BLACK_THRESHOLD of the brightness range).
const DEFAULT_DARKNESS = 0;
const MAX_BLACK_THRESHOLD = 0.4;

const EFFECT_NAME = 'darkshift';

// Apps in these freedesktop.org categories already rely on accurate,
// untouched colors (video playback, image/video editing, games), so the
// filter is skipped for them.
const EXCLUDED_CATEGORIES = ['Video', 'AudioVideo', 'Graphics', 'Game'];

const DarkshiftEffect = GObject.registerClass(
class DarkshiftEffect extends Clutter.ShaderEffect {
    vfunc_get_static_shader_source() {
        return `
            uniform sampler2D tex;
            uniform float black_boost;
            uniform float blue_shift;
            uniform float red_shift;
            uniform float gray_darken;
            uniform float protect_green;
            uniform float normalize_green;
            uniform float neutral_protect;
            uniform float neutral_green_gain;
            uniform float black_threshold;

            void main() {
                vec4 color = texture2D(tex, cogl_tex_coord_in[0].st);
                vec3 originalRgb = color.rgb;
                float chroma = max(color.r, max(color.g, color.b)) -
                               min(color.r, min(color.g, color.b));
                float originalGreen = color.g;

                /* How green a pixel is: 0 for grays and other hues, ramping
                 * to 1 as soon as green clearly leads red and blue. */
                float greenness = smoothstep(0.0, 0.06,
                    originalRgb.g - max(originalRgb.r, originalRgb.b)) * protect_green;

                /* Black threshold: everything at or below it becomes pure
                 * black, the rest is stretched back to the full range. */
                color.rgb = max(color.rgb - black_threshold, 0.0) / (1.0 - black_threshold);

                /* Crush blacks: a gentle power curve pushes dark tones
                 * closer to true black without blowing out highlights. */
                color.rgb = pow(color.rgb, vec3(1.0 + black_boost));

                /* Darken grays further: the less saturated a color is,
                 * the closer it is to a neutral gray, so push it towards
                 * black on top of the crush above, whatever their
                 * brightness (light-theme backgrounds included). */
                float maxChannel = max(color.r, max(color.g, color.b));
                float minChannel = min(color.r, min(color.g, color.b));
                float grayness = 1.0 - (maxChannel - minChannel);
                color.rgb *= mix(1.0, gray_darken, grayness);

                /* Green pixels get their original green back instead of
                 * the darkened one; grays have no greenness, so they
                 * still go to black. */
                color.g = mix(color.g, max(color.g, originalGreen), greenness);

                /* Shift light away from the blue sub-pixel: take some of
                 * the blue channel's energy and redistribute it onto red
                 * and green, which is where OLEDs are more efficient. */
                /* With neutral_protect on, only colored pixels get the red/blue
                 * shift; shifting neutrals (white pages, gray text) just tints
                 * them green. */
                float shiftAmount = mix(1.0, smoothstep(0.03, 0.25, chroma), neutral_protect);
                float removedBlue = color.b * blue_shift * shiftAmount;
                color.b -= removedBlue;
                color.r += removedBlue * 0.6;
                color.g += removedBlue * 0.4;

                /* Shift light away from the red sub-pixel too, moving it
                 * onto green. */
                float removedRed = color.r * red_shift * shiftAmount;
                color.r -= removedRed;
                color.g += removedRed;

                /* Keep greens bright: for green-dominant pixels, add
                 * whatever perceived brightness (luma) the darkening and
                 * shifting above took away back through the green channel,
                 * the one sub-pixel that is cheap to drive on an OLED. */
                vec3 lumaWeights = vec3(0.2126, 0.7152, 0.0722);
                float lumaLost = max(dot(originalRgb, lumaWeights) - dot(color.rgb, lumaWeights), 0.0);
                color.g = clamp(color.g + lumaLost / lumaWeights.g * greenness, 0.0, 1.0);

                /* Normalize greens: map the original green onto a narrow
                 * band (0.4 .. 0.8) so dim greens are lifted and the
                 * brightest ones are capped instead of glaring. */
                float normalizedGreen = 0.4 + 0.4 * originalGreen;
                color.g = mix(color.g, normalizedGreen, greenness * normalize_green);

                /* Neutral pixels (white pages, gray text and backgrounds) are
                 * redrawn using the green sub-pixel only, which is the
                 * cheapest one to light on an OLED. Brightness follows the
                 * original gray on a curve, scaled by the gain, so black text
                 * stays black on a dim green page. */
                float neutralness = 1.0 - smoothstep(0.03, 0.25, chroma);
                float neutralLevel = max(max(originalRgb.r, max(originalRgb.g, originalRgb.b)) - black_threshold, 0.0) /
                                     (1.0 - black_threshold);
                float neutralGreen = pow(neutralLevel, 1.6) * neutral_green_gain;
                color.rgb = mix(color.rgb, vec3(0.0, neutralGreen, 0.0),
                                neutralness * step(0.001, neutral_green_gain));

                /* Pure red marks the window outline: swap it for a dim
                 * white-gray so the outline is neither red nor green. */
                float isOutline = step(0.9, originalRgb.r) * step(originalRgb.g, 0.1) * step(originalRgb.b, 0.1);
                color.rgb = mix(color.rgb, vec3(0.35) * color.a, isOutline);

                cogl_color_out = color * cogl_color_in;
            }
        `;
    }

    // A plain JS number like 1.0 or 2.0 is boxed as an int, which GL rejects
    // for a `uniform float` (leaving it at 0), so box it as a float explicitly.
    _setFloat(name, value) {
        const gvalue = new GObject.Value();
        gvalue.init(GObject.TYPE_FLOAT);
        gvalue.set_float(value);
        this.set_uniform_value(name, gvalue);
    }

    setExtreme(extreme) {
        this._extreme = extreme;
        this.queue_repaint();
    }

    setDarkness(darkness) {
        this._darkness = darkness;
        this.queue_repaint();
    }

    vfunc_paint_target(node, paintContext) {
        const settings = this._extreme ? EXTREME_SETTINGS : NORMAL_SETTINGS;
        const darkness = this._darkness ?? DEFAULT_DARKNESS;
        this.set_uniform_value('tex', 0);
        this._setFloat('black_threshold', darkness * MAX_BLACK_THRESHOLD);
        this._setFloat('black_boost', settings.blackBoost);
        this._setFloat('blue_shift', settings.blueShift);
        this._setFloat('red_shift', settings.redShift);
        this._setFloat('gray_darken', settings.grayDarken);
        this._setFloat('protect_green', settings.protectGreen);
        this._setFloat('normalize_green', settings.normalizeGreen);
        this._setFloat('neutral_protect', settings.neutralProtect);
        this._setFloat('neutral_green_gain', settings.neutralGreenGain);
        super.vfunc_paint_target(node, paintContext);
    }
});

const DarkshiftToggle = GObject.registerClass({
    Signals: {'extreme-changed': {}, 'darkness-changed': {}},
},
class DarkshiftToggle extends QuickMenuToggle {
    constructor() {
        super({
            title: _('Darkshift'),
            iconName: 'preferences-desktop-display-symbolic',
            toggleMode: true,
        });

        this.menu.setHeader('preferences-desktop-display-symbolic', _('Darkshift'));

        this.extremeItem = new PopupMenu.PopupMenuItem(_('Extreme mode'));
        this.extremeItem.setOrnament(PopupMenu.Ornament.NONE);
        this.extremeItem.connect('activate', () => {
            this.extreme = !this.extreme;
        });
        this.menu.addMenuItem(this.extremeItem);

        this.menu.addMenuItem(new PopupMenu.PopupSeparatorMenuItem());

        this._darkness = DEFAULT_DARKNESS;
        const sliderItem = new PopupMenu.PopupBaseMenuItem({activate: false});
        const slider = new Slider(DEFAULT_DARKNESS);
        slider.x_expand = true;
        slider.connect('notify::value', () => {
            this._darkness = slider.value;
            this.emit('darkness-changed');
        });
        sliderItem.add_child(new St.Label({
            text: _('Darkness'),
            y_align: Clutter.ActorAlign.CENTER,
        }));
        sliderItem.add_child(slider);
        this.menu.addMenuItem(sliderItem);

        this.extreme = false;
    }

    get darkness() {
        return this._darkness;
    }

    get extreme() {
        return this._extreme;
    }

    set extreme(value) {
        this._extreme = value;
        this.extremeItem.setOrnament(value ? PopupMenu.Ornament.CHECK : PopupMenu.Ornament.NONE);
        this.emit('extreme-changed');
    }
});

const DarkshiftIndicator = GObject.registerClass(
class DarkshiftIndicator extends SystemIndicator {
    constructor() {
        super();

        this._enabled = false;
        this._windowTracker = Shell.WindowTracker.get_default();
        this._actorAddedId = 0;
        this._actorRemovedId = 0;
        this._appChangedId = 0;
        this._outlines = new Map();
        this._extreme = false;
        this._darkness = DEFAULT_DARKNESS;

        this._indicator = this._addIndicator();
        this._indicator.iconName = 'preferences-desktop-display-symbolic';

        this._toggle = new DarkshiftToggle();
        this._toggle.bind_property('checked',
            this._indicator, 'visible',
            GObject.BindingFlags.SYNC_CREATE);
        this._toggle.connect('notify::checked', toggle => {
            if (toggle.checked)
                this._enableEffect();
            else
                this._disableEffect();
        });
        this._toggle.connect('extreme-changed', toggle => {
            this._extreme = toggle.extreme;
            this._applySettingsToActors();
        });
        this._toggle.connect('darkness-changed', toggle => {
            this._darkness = toggle.darkness;
            this._applySettingsToActors();
        });
        this.quickSettingsItems.push(this._toggle);
    }

    _applySettingsToActors() {
        global.get_window_actors().forEach(actor => {
            const effect = actor.get_effect(EFFECT_NAME);
            if (effect) {
                effect.setExtreme(this._extreme);
                effect.setDarkness(this._darkness);
            }
        });

        const wallpaperEffect = Main.layoutManager._backgroundGroup.get_effect(WALLPAPER_EFFECT_NAME);
        if (wallpaperEffect)
            this._updateWallpaperEffect(wallpaperEffect);
    }

    _updateWallpaperEffect(effect) {
        effect.set_brightness(this._extreme
            ? EXTREME_WALLPAPER_BRIGHTNESS : NORMAL_WALLPAPER_BRIGHTNESS);
    }

    _enableWallpaperEffect() {
        const backgroundGroup = Main.layoutManager._backgroundGroup;
        if (backgroundGroup.get_effect(WALLPAPER_EFFECT_NAME))
            return;

        const effect = new Clutter.BrightnessContrastEffect();
        this._updateWallpaperEffect(effect);
        backgroundGroup.add_effect_with_name(WALLPAPER_EFFECT_NAME, effect);
    }

    _disableWallpaperEffect() {
        Main.layoutManager._backgroundGroup.remove_effect_by_name(WALLPAPER_EFFECT_NAME);
    }

    // Apps whose primary purpose is accurate color (video, graphics,
    // games) should be left untouched.
    _shouldSkip(app) {
        if (!app)
            return false;

        const appInfo = app.get_app_info();
        const categoriesString = appInfo ? appInfo.get_categories() : null;
        if (!categoriesString)
            return false;

        const categories = categoriesString.split(';').filter(c => c.length > 0);
        return categories.some(c => EXCLUDED_CATEGORIES.includes(c));
    }

    // A 1px border drawn just inside the visible window frame, so the window
    // edge stands out against the darkened wallpaper.
    _addOutline(windowActor) {
        const metaWindow = windowActor.get_meta_window();
        if (!metaWindow || this._outlines.has(windowActor))
            return;

        const outline = new St.Widget({
            style: OUTLINE_KEY_STYLE,
            reactive: false,
        });
        windowActor.add_child(outline);

        const update = () => {
            const frame = metaWindow.get_frame_rect();
            const buffer = metaWindow.get_buffer_rect();
            outline.set_position(frame.x - buffer.x, frame.y - buffer.y);
            outline.set_size(frame.width, frame.height);
            outline.visible = !metaWindow.is_fullscreen();
        };
        update();

        const ids = ['position-changed', 'size-changed', 'notify::fullscreen']
            .map(signal => metaWindow.connect(signal, update));
        this._outlines.set(windowActor, {outline, metaWindow, ids});
    }

    _removeOutline(windowActor) {
        const entry = this._outlines.get(windowActor);
        if (!entry)
            return;

        this._outlines.delete(windowActor);
        entry.ids.forEach(id => entry.metaWindow.disconnect(id));
        entry.outline.destroy();
    }

    _addEffectToActor(windowActor) {
        try {
            if (!(windowActor instanceof Meta.WindowActor))
                return;

            this._addOutline(windowActor);

            if (windowActor.get_effect(EFFECT_NAME))
                return;

            const metaWindow = windowActor.get_meta_window();
            const app = metaWindow ? this._windowTracker.get_window_app(metaWindow) : null;
            if (this._shouldSkip(app)) {
                const entry = this._outlines.get(windowActor);
                if (entry)
                    entry.outline.set_style(OUTLINE_PLAIN_STYLE);
                return;
            }

            const effect = new DarkshiftEffect();
            effect.setExtreme(this._extreme);
            effect.setDarkness(this._darkness);
            windowActor.add_effect_with_name(EFFECT_NAME, effect);
        } catch (e) {
            console.error(`Darkshift: failed to apply effect to window: ${e}`);
        }
    }

    _removeEffectFromActor(windowActor) {
        try {
            if (windowActor instanceof Meta.WindowActor) {
                windowActor.remove_effect_by_name(EFFECT_NAME);
                this._removeOutline(windowActor);
            }
        } catch (e) {
            console.error(`Darkshift: failed to remove effect from window: ${e}`);
        }
    }

    _refreshAllActors() {
        global.get_window_actors().forEach(actor => {
            this._removeEffectFromActor(actor);
            this._addEffectToActor(actor);
        });
    }

    _enableEffect() {
        if (this._enabled)
            return;
        this._enabled = true;

        this._enableWallpaperEffect();
        global.get_window_actors().forEach(actor => this._addEffectToActor(actor));

        this._actorAddedId = global.window_group.connect('child-added',
            (_group, actor) => this._addEffectToActor(actor));
        this._actorRemovedId = global.window_group.connect('child-removed',
            (_group, actor) => this._removeEffectFromActor(actor));
        // An app's identity can resolve after its window first appears
        // (e.g. while it is still starting up), so re-check assignments.
        this._appChangedId = this._windowTracker.connect('tracked-windows-changed',
            () => this._refreshAllActors());
    }

    _disableEffect() {
        if (!this._enabled)
            return;
        this._enabled = false;

        this._disableWallpaperEffect();
        global.get_window_actors().forEach(actor => this._removeEffectFromActor(actor));

        if (this._actorAddedId) {
            global.window_group.disconnect(this._actorAddedId);
            this._actorAddedId = 0;
        }
        if (this._actorRemovedId) {
            global.window_group.disconnect(this._actorRemovedId);
            this._actorRemovedId = 0;
        }
        if (this._appChangedId) {
            this._windowTracker.disconnect(this._appChangedId);
            this._appChangedId = 0;
        }
    }

    destroy() {
        this._disableEffect();
        super.destroy();
    }
});

export default class DarkshiftExtension extends Extension {
    enable() {
        this._indicator = new DarkshiftIndicator();
        Main.panel.statusArea.quickSettings.addExternalIndicator(this._indicator);
    }

    disable() {
        this._indicator.quickSettingsItems.forEach(item => item.destroy());
        this._indicator.destroy();
        this._indicator = null;
    }
}
